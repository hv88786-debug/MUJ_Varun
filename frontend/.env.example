# Copy this file to .env in this same folder (varun-frontend/), then
# point it at your backend. Vite only exposes vars prefixed VITE_ to
# client code, and only picks up .env changes on restart.

# Local dev (Flask backend running on default port):
VITE_BACKEND_URL=http://localhost:5000

# Deployed on Render (replace with your actual backend host):
# VITE_BACKEND_URL=https://varun-backend.onrender.com
# On Vercel, set this same var under Project → Settings → Environment
# Variables — Vercel does not read this .env.example file.

# Firebase Realtime Database base URL (sensors/alerts/asha_reports live data).
# Optional — if left blank, the app falls back to the hardcoded default in
# AquaGuard.jsx. Set this so the DB URL isn't hardcoded in frontend source.
VITE_FIREBASE_BASE=https://varun-735df-default-rtdb.firebaseio.com
