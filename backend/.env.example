# Copy this file to .env in the same folder as app.py, then fill in the
# real values. Never commit the real .env — only this .example file.

# ── Telegram (required for Telegram alerts) ──
# Get BOT_TOKEN from @BotFather on Telegram (/newbot).
TELEGRAM_BOT_TOKEN_ALERTS=
TELEGRAM_BOT_TOKEN_HIERARCHY=

# Get CHAT_ID by adding the bot to the authority group/chat, sending any
# message there, then visiting:
#   https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
# and reading the "chat":{"id": ...} field. Group IDs are negative
# (e.g. -1001234567890).
TELEGRAM_CHAT_ID_ALERTS=
TELEGRAM_CHAT_ID_HIERARCHY=

# ── Twilio (not yet implemented — stubbed in app.py) ──
# Leave these blank for now. When Twilio dispatch is implemented, fill
# these in from the Twilio Console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# ── Groq + Firebase prediction engine (predict.py) ──
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=

# Your Firebase Realtime Database base URL (no trailing slash), e.g.
# https://your-project-default-rtdb.firebaseio.com
FIREBASE_BASE=
# Firebase node containing the current sensor reading.
FIREBASE_SENSOR_PATH=sensor
DEFAULT_VILLAGE_NAME=Nasirabad
DEFAULT_VILLAGE_KEY=village_X
DEFAULT_PANCHAYAT_KEY=panchayat_Y
DEFAULT_TEHSIL_KEY=tehsil_Z
DEFAULT_DISTRICT_KEY=district_D

# Optional Firebase REST authentication. Use a database secret only for the
# demo; use a short-lived ID token or a server-side service account in prod.
FIREBASE_DATABASE_SECRET=
FIREBASE_ID_TOKEN=

# Optional group for confirmed incidents. If blank, the district group is used.
TELEGRAM_ACTION_CHAT_ID=

# Polling interval for newly created Firebase alerts.
ALERT_POLL_SECONDS=5

# Optional — how often (seconds) the background loop predicts. Default 5.
PREDICT_EVERY=5

# Optional — Groq model name. Default openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-120b

# ── Deployment (Render) ──
# Your deployed Vercel frontend URL, e.g. https://varun.vercel.app
# Restricts CORS to just your frontend. Leave blank in local dev — it
# falls back to allowing all origins so localhost still works.
FRONTEND_URL=
